<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Global rule: users whose roles define warehouses see quants of those warehouses only.
         Users without such roles (e.g. admin) are not restricted. -->
    <record id="stock_quant_role_warehouse_rule" model="ir.rule">
        <field name="name">Stock quant: role warehouses</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="domain_force">[('location_id.warehouse_id', 'in', user.role_warehouse_ids.ids)] if user.role_warehouse_ids else []</field>
    </record>
</odoo>
